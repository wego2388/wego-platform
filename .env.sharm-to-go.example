# Sharm To Go VPS stack — copy to an ignored `.env.sharm-to-go` and fill in.
# Nothing in this file is a real credential; the values below are placeholders.
COMPOSE_PROJECT_NAME=sharm-to-go

# Generate a real one: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
STG_POSTGRES_PASSWORD=replace-with-a-generated-secret
STG_POSTGRES_DB=wego_sharm_to_go
STG_POSTGRES_USER=wego_app

# Public hostnames. Both DNS A records must point at the VPS before the first
# `--profile tls` start. Use two different hostnames (customer site vs staff
# admin) — the admin one should never be linked from the public site.
STG_SITE_DOMAIN=sharmtogo.example
STG_ADMIN_DOMAIN=admin.sharmtogo.example

# Loopback-only ports for checking each surface without DNS/TLS.
STG_EDGE_SITE_PORT=58180
STG_EDGE_ADMIN_PORT=58181
