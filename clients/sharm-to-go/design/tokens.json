{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Sharm To Go",
  "version": "0.1.0",
  "color": {
    "brand": {
      "sea": "#075f67",
      "seaBright": "#0b8691",
      "lagoon": "#d8f1ef",
      "sand": "#f4dec0",
      "sun": "#f2a93b",
      "sky": "#2f7fa3",
      "terracotta": "#c8593a"
    },
    "surface": {
      "canvas": "#f7fbfa",
      "default": "#ffffff",
      "raised": "#ffffff",
      "inverse": "#102f35"
    },
    "text": {
      "primary": "#102f35",
      "secondary": "#587078",
      "inverse": "#ffffff",
      "link": "#075f67"
    },
    "border": {
      "default": "#d5e1df",
      "strong": "#9bb7b5",
      "focus": "#f2a93b"
    },
    "status": {
      "info": "#155e75",
      "infoSoft": "#cffafe",
      "success": "#0f7a3d",
      "successSoft": "#dcf5e4",
      "warning": "#8a5809",
      "warningSoft": "#fff1d8",
      "danger": "#b3261e",
      "dangerSoft": "#fbdcd9"
    }
  },
  "typography": {
    "displayFamily": "Fredoka Variable",
    "latinFamily": "Inter Variable",
    "arabicFamily": "Noto Sans Arabic Variable",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "sizePx": { "caption": 12, "bodySmall": 14, "body": 16, "title": 20, "heading": 32, "display": 56 }
  },
  "categoryAccent": {
    "_comment": "One accent per homepage discovery category, so each activity type reads with its own visual identity instead of one flat teal wash. Arabic-script headings don't get a display-font swap (no equivalent playful variable Arabic face on Fontsource yet) — they stay on arabicFamily at bold weight.",
    "sea": "sea-bright",
    "desert": "sun",
    "transfers": "sky",
    "city": "terracotta"
  },
  "spacePx": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80 },
  "radiusPx": { "control": 12, "card": 20, "panel": 28, "pill": 999 },
  "shadow": {
    "card": "0 10px 30px rgb(16 47 53 / 0.08)",
    "floating": "0 20px 60px rgb(7 95 103 / 0.16)"
  },
  "breakpointPx": { "mobile": 390, "tablet": 768, "desktop": 1024, "wide": 1440 },
  "layout": { "contentMaxPx": 1280, "readingMaxPx": 720, "touchTargetMinPx": 44 },
  "motionMs": { "fast": 120, "standard": 200, "slow": 320 }
}
