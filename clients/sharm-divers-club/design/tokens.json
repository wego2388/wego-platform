    "text": { "primary": "#faf6ee", "secondary": "#a9c6c6" },
    "border": { "default": "#1f4753" },
    "brand": { "deepBright": "#1fa9b8" },
    "status": { "infoSoft": "#0d3a47", "successSoft": "#0f3a24", "warningSoft": "#3a2a0a", "dangerSoft": "#3a1210" }
