    "sizePx": { "caption": 12, "bodySmall": 14, "body": 16, "title": 20, "heading": 32, "display": 54 }
  },
  "spacePx": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80 },
