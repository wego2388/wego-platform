      "turquoise": "#1fa9b8",
      "turquoiseSoft": "#d9f1f1",
      "sand": "#c9975a",
      "sandSoft": "#f1e1c3"
    },
    "surface": {
      "canvas": "#faf6ee",
      "default": "#ffffff",
      "raised": "#ffffff",
      "inverse": "#0b2027"
    },
    "text": {
      "primary": "#0b2027",
      "secondary": "#3c555c",
      "inverse": "#ffffff",
      "link": "#0a5a63"
    },
    "border": {
      "default": "#dde4e1",
