# =============================================================================
# Safari Tours Sharm — PRODUCTION environment template (WEGO-016-OPS2-G)
# =============================================================================
# Copy to /srv/safari-tours-sharm/shared/.env.production on the VPS, mode 0600,
# owned by the deploy user. NEVER commit the filled copy, never paste it into
# chat/tickets, never copy any value from El Kheima's env files.
# Every CHANGE_ME_* must be replaced; the stack refuses to start while a
# required value is missing. Generate passwords on the server, e.g.:
#   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
#
# Read by:
#   infrastructure/compose/safari-tours-sharm.compose.yaml       (base)
#   infrastructure/compose/safari-tours-sharm.production.yaml    (overlay)
#   platform/apps/safari-tours-sharm/src/main/resources/application.yml
#   scripts/safari-ops/*.sh  (the SAFARI_* ops block at the end; export them
#                             in cron, the scripts do not read this file)
# =============================================================================

# --- Identity of the Compose project ----------------------------------------
# The overlay pins `name: safari-tours-sharm-prod` and the volume names; this
# value is kept identical so tools that read the variable agree with it.
COMPOSE_PROJECT_NAME=safari-tours-sharm-prod

# --- Release images (prebuilt, reviewed; no build on the VPS) ---------------
# Tag = release ID from RELEASE_READINESS.md. After `docker load`, compare
# `docker image inspect --format '{{.Id}}' <image>` with the image IDs recorded
# in the release manifest. With a registry, use name@sha256:<digest> instead.
SAFARI_BACKEND_IMAGE=safari-tours-sharm-backend:CHANGE_ME_RELEASE_ID
SAFARI_ERP_IMAGE=safari-tours-sharm-erp:CHANGE_ME_RELEASE_ID
SAFARI_SITE_IMAGE=safari-tours-sharm-site:CHANGE_ME_RELEASE_ID

# --- Loopback port of the Safari edge ----------------------------------------
# Chosen by Codex after preflight (`ss -ltnp`); 58080 is a candidate only.
# The overlay binds it to 127.0.0.1 — the gateway vhost proxies here.
SAFARI_EDGE_PORT=58080

# --- PostgreSQL (Safari only; no published port in production) --------------
WEGO_POSTGRES_DB=wego_safari_tours_sharm
WEGO_POSTGRES_USER=wego_safari_app
WEGO_POSTGRES_PASSWORD=CHANGE_ME_GENERATE_ON_SERVER
# Unused in production (the overlay removes the DB port); kept so the base
# file interpolates cleanly. Do not publish PostgreSQL.
WEGO_POSTGRES_PORT=55432
# Base-file edge port variable; unused in production (overlay uses SAFARI_EDGE_PORT).
WEGO_EDGE_PORT=58080
SAFARI_DB_POOL_SIZE=5

# --- Public origin (SEO canonical/hreflang/sitemap, e-mail links) ------------
WEGO_SITE_PUBLIC_URL=https://safaritourssharm.com
# Optional analytics — public IDs only, loaded after visitor consent. Empty = none.
WEGO_SITE_GA4_ID=
WEGO_SITE_META_PIXEL_ID=

# --- Booking mode (launch decision) -----------------------------------------
# ENQUIRY_ONLY: website request saved to ERP, staff confirmation/collection;
# WhatsApp is for questions only. A submitted request is not a seat reservation.
# ONLINE_PAYMENT only after the Paymob sandbox gate AND owner GO.
TOURS_OPERATOR_BOOKING_MODE=ENQUIRY_ONLY
# Forced to "false" by both compose files; listed for completeness only.
TOURS_OPERATOR_PAYMOB_MOCK_ENABLED=false

# --- Paymob (real adapter) ---------------------------------------------------
# Fresh, payment-free ENQUIRY_ONLY install: leave ALL of these empty.
# Partial values refuse startup. If payment history exists, ALL must be set,
# even in ENQUIRY_ONLY (historical callbacks/refunds). Never delete them later.
TOURS_OPERATOR_PAYMOB_SECRET_KEY=
TOURS_OPERATOR_PAYMOB_PUBLIC_KEY=
TOURS_OPERATOR_PAYMOB_API_KEY=
TOURS_OPERATOR_PAYMOB_INTEGRATION_ID=
TOURS_OPERATOR_PAYMOB_OWNER_ID=
TOURS_OPERATOR_PAYMOB_HMAC_SECRET=
# When enabled: https://safaritourssharm.com/api/v1/tours-operator/payments/paymob-callback
TOURS_OPERATOR_PAYMOB_NOTIFICATION_URL=
TOURS_OPERATOR_PAYMOB_REDIRECTION_URL=

# --- Customer e-mail notifications (off until SMTP is approved) -------------
# true requires SPRING_MAIL_HOST (+ credentials) or startup fails on purpose.
TOURS_OPERATOR_NOTIFICATIONS_ENABLED=false
TOURS_OPERATOR_NOTIFICATIONS_FROM=
TOURS_OPERATOR_NOTIFICATIONS_REPLY_TO=
TOURS_OPERATOR_REVIEW_URL=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- Resource budget (Codex sets real numbers after preflight `free -m`,
#     `nproc`, `df -h`; Safari must leave El Kheima's headroom untouched) ----
SAFARI_POSTGRES_CPUS=1.0
SAFARI_POSTGRES_MEMORY=768m
SAFARI_BACKEND_CPUS=1.5
SAFARI_BACKEND_MEMORY=1024m
SAFARI_BACKEND_JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError
SAFARI_ERP_CPUS=0.5
SAFARI_ERP_MEMORY=256m
SAFARI_SITE_CPUS=1.0
SAFARI_SITE_MEMORY=384m
SAFARI_EDGE_CPUS=0.5
SAFARI_EDGE_MEMORY=128m
# json-file rotation per container (5 x 10m = 50 MB max each).
SAFARI_LOG_MAX_SIZE=10m
SAFARI_LOG_MAX_FILE=5

# =============================================================================
# Ops scripts (scripts/safari-ops/*.sh) — export in the deploy user's crontab
# =============================================================================
SAFARI_COMPOSE_PROJECT=safari-tours-sharm-prod
SAFARI_BACKUP_DIR=/srv/safari-tours-sharm/backups
SAFARI_HEALTH_URL=http://127.0.0.1:58080
SAFARI_PUBLIC_HOST=safaritourssharm.com
# Public key ID whose PRIVATE key is NOT on this server (owner custody).
SAFARI_BACKUP_GPG_RECIPIENT=CHANGE_ME_OWNER_BACKUP_KEY_ID
SAFARI_BACKUP_KEEP_DAYS=14
SAFARI_BACKUP_MAX_AGE_HOURS=26
SAFARI_DRILL_MAX_AGE_DAYS=8
SAFARI_DISK_MAX_PERCENT=85
SAFARI_CERT_MIN_DAYS=14
# Command that receives WARN/FAIL lines on stdin (owner decides the channel).
SAFARI_ALERT_COMMAND=
# Never set in production (plaintext bundles are for local drills only).
# SAFARI_ALLOW_PLAIN_BACKUP=1
