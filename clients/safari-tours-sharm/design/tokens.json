{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Safari Tours Sharm",
  "version": "0.1.0",
  "color": {
    "brand": {
      "ocean": "#0A2342",
      "oceanBright": "#1B4F8A",
      "coral": "#FF6B6B",
      "sand": "#C8A97E",
      "sandSoft": "#F0E6D3",
      "sunset": "#FF8C42",
      "palm": "#2D6A4F"
    },
    "surface": {
      "canvas": "#F7F4F0",
      "default": "#FFFFFF",
      "raised": "#FFFFFF",
      "inverse": "#0A2342"
    },
    "text": {
      "primary": "#1A1A2E",
      "secondary": "#6B7280",
      "inverse": "#FFFFFF",
      "link": "#1B4F8A"
    },
    "border": {
      "default": "#E8E4DF",
      "strong": "#B0A89E",
      "focus": "#C8A97E"
    },
    "status": {
      "info": "#155e75",
      "infoSoft": "#cffafe",
      "success": "#0f7a3d",
      "successSoft": "#dcf5e4",
      "warning": "#8a5809",
      "warningSoft": "#fff1d8",
      "danger": "#b3261e",
      "dangerSoft": "#fbdcd9"
    }
  },
  "typography": {
    "displayFamily": "Playfair Display",
    "latinFamily": "Inter Variable",
    "arabicFamily": "Cairo",
    "arabicFamilyFallback": "Tajawal",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "sizePx": { "caption": 12, "bodySmall": 14, "body": 16, "title": 20, "heading": 32, "display": 56 }
  },
  "spacePx": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80 },
  "radiusPx": { "control": 8, "card": 12, "panel": 24, "pill": 999 },
  "shadow": {
    "card": "0 10px 30px rgb(10 35 66 / 0.10)",
    "floating": "0 20px 60px rgb(10 35 66 / 0.18)"
  },
  "breakpointPx": { "mobile": 390, "tablet": 768, "desktop": 1024, "wide": 1440 },
  "layout": { "contentMaxPx": 1280, "readingMaxPx": 720, "touchTargetMinPx": 44 },
  "motionMs": { "fast": 120, "standard": 200, "slow": 320, "dramatic": 800 }
}
