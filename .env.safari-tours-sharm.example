# Safari Tours Sharm isolated local/e2e bundle. Placeholder credentials only.
COMPOSE_PROJECT_NAME=wego-safari-tours-sharm
WEGO_POSTGRES_DB=wego_safari_tours_sharm
WEGO_POSTGRES_USER=wego_app
WEGO_POSTGRES_PASSWORD=wego-local-postgres-only
WEGO_POSTGRES_PORT=55437
WEGO_EDGE_PORT=58085
WEGO_REDIS_PASSWORD=wego-local-redis-only
WEGO_REDIS_PORT=56385
# Public site origin for canonical/hreflang links (production: https://safaritourssharm.com)
WEGO_SITE_PUBLIC_URL=http://127.0.0.1:58085
# Optional analytics (loaded only after visitor consent). Public IDs, not secrets.
WEGO_SITE_GA4_ID=
WEGO_SITE_META_PIXEL_ID=

# Default fail-closed online checkout. For a FRESH payment-free installation
# only, explicitly set ENQUIRY_ONLY to take WhatsApp enquiries without holds.
# Never remove Paymob settings from an installation with payment history.
TOURS_OPERATOR_BOOKING_MODE=ONLINE_PAYMENT
# Paymob — required for online checkout OR any historical payment records.
# Never commit real values; set them only in the server's private env file.
TOURS_OPERATOR_PAYMOB_SECRET_KEY=
TOURS_OPERATOR_PAYMOB_PUBLIC_KEY=
TOURS_OPERATOR_PAYMOB_API_KEY=
TOURS_OPERATOR_PAYMOB_INTEGRATION_ID=
TOURS_OPERATOR_PAYMOB_OWNER_ID=
TOURS_OPERATOR_PAYMOB_HMAC_SECRET=
TOURS_OPERATOR_PAYMOB_NOTIFICATION_URL=
TOURS_OPERATOR_PAYMOB_REDIRECTION_URL=
