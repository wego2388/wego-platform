{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wego.local/schemas/release-profile-catalog.schema.json",
  "title": "Wego release profile catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" },
    "stringMap": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "webArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "path", "dockerfile"],
      "properties": {
        "packageName": { "type": "string", "pattern": "^@wego/[a-z0-9-]+$" },
        "path": { "$ref": "#/$defs/relativePath" },
        "dockerfile": { "$ref": "#/$defs/relativePath" },
        "buildArgs": { "$ref": "#/$defs/stringMap" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "backend", "publicSite", "staffApp", "apiContract", "compose", "dataIsolation"],
      "properties": {
        "productId": { "type": "string", "pattern": "^wego-[a-z0-9-]+$" },
        "backend": {
          "type": "object",
          "additionalProperties": false,
            "required": ["gradleProject", "projectPath", "dockerfile", "jar", "includedModules", "migrationVersions", "migrationFiles"],
          "properties": {
            "gradleProject": { "type": "string", "pattern": "^:[a-z0-9:-]+$" },
            "projectPath": { "$ref": "#/$defs/relativePath" },
            "dockerfile": { "$ref": "#/$defs/relativePath" },
            "jar": { "$ref": "#/$defs/relativePath" },
            "includedModules": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^(platform|product)\\.[a-z0-9-]+$" }
            },
            "migrationVersions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[0-9]+$" }
            },
            "migrationFiles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/relativePath" }
            }
          }
        },
        "publicSite": { "$ref": "#/$defs/webArtifact" },
        "staffApp": { "$ref": "#/$defs/webArtifact" },
        "apiContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "ownedPathPrefixes"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "ownedPathPrefixes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^/api/v1/[a-z0-9-]+/$" }
            }
          }
        },
        "compose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "environmentExample", "services"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "environmentExample": { "$ref": "#/$defs/relativePath" },
            "services": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
            }
          }
        },
        "dataIsolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "allowedTablePrefixes", "allowedPermissionPrefixes"],
          "properties": {
            "schema": { "const": "wego" },
            "allowedTablePrefixes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*_$" }
            },
            "allowedPermissionPrefixes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[.:]$" }
            }
          }
        }
      }
    }
  }
}
