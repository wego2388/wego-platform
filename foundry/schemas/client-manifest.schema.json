{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wego.dev/foundry/client-manifest/v1",
  "title": "Wego client manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "clientId",
    "displayName",
    "product",
    "organization",
    "experienceProfiles",
    "deploymentIsolation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "clientId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^wego-[a-z][a-z0-9-]*$" },
        "version": { "$ref": "#/$defs/releaseVersion" }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "defaultLocale", "supportedLocales", "currency"],
      "properties": {
        "timezone": {
          "type": "string",
          "pattern": "^[A-Za-z_]+(?:/[A-Za-z0-9_+-]+)+$"
        },
        "defaultLocale": { "$ref": "#/$defs/locale" },
        "supportedLocales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/locale" }
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "experienceProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["STANDARD", "VOICE_FIRST", "SIMPLIFIED"]
      }
    },
    "deploymentIsolation": { "const": "ISOLATED_INSTANCE" }
  },
  "$defs": {
    "releaseVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    }
  }
}
