{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wego.local/schemas/release-plan.schema.json",
  "title": "Wego executable release plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "clientId", "product", "deploymentIsolation", "modules", "artifacts", "dataIsolation", "digests"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "clientId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^wego-[a-z0-9-]+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
      }
    },
    "deploymentIsolation": { "const": "ISOLATED_INSTANCE" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(platform|product)\\.[a-z0-9-]+$" }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "publicSite", "staffApp", "apiContract", "compose"],
      "properties": {
        "backend": { "type": "object" },
        "publicSite": { "type": "object" },
        "staffApp": { "type": "object" },
        "apiContract": { "type": "object" },
        "compose": { "type": "object" }
      }
    },
    "dataIsolation": { "type": "object" },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseLock", "releaseProfiles"],
      "properties": {
        "releaseLock": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "releaseProfiles": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
