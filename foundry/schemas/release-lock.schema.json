{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wego.dev/foundry/release-lock/v1",
  "title": "Wego deterministic client release lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "clientId",
    "platformVersion",
    "product",
    "contractVersions",
    "modules",
    "manifestDigests"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "clientId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "platformVersion": { "$ref": "#/$defs/buildVersion" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^wego-[a-z][a-z0-9-]*$" },
        "version": { "$ref": "#/$defs/releaseVersion" }
      }
    },
    "contractVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["httpApi"],
      "properties": {
        "httpApi": { "const": "v1" }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "$ref": "#/$defs/moduleId" },
          "version": { "$ref": "#/$defs/buildVersion" }
        }
      }
    },
    "manifestDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "product", "moduleCatalog"],
      "properties": {
        "client": { "$ref": "#/$defs/sha256" },
        "product": { "$ref": "#/$defs/sha256" },
        "moduleCatalog": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "releaseVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "buildVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^(platform|product)\\.[a-z][a-z0-9-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
