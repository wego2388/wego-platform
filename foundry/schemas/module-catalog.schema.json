{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wego.dev/foundry/module-catalog/v1",
  "title": "Wego module and capability catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "owner", "path", "version", "capabilities"],
        "properties": {
          "id": { "$ref": "#/$defs/moduleId" },
          "kind": { "enum": ["PLATFORM_KERNEL", "PRODUCT_MARKER"] },
          "owner": {
            "type": "string",
            "pattern": "^(platform|wego-[a-z][a-z0-9-]*)$"
          },
          "path": {
            "type": "string",
            "pattern": "^(platform|products)/[a-z0-9][a-z0-9/-]*$"
          },
          "version": { "$ref": "#/$defs/buildVersion" },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/capabilityId" }
          }
        }
      }
    }
  },
  "$defs": {
    "buildVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^(platform|product)\\.[a-z][a-z0-9-]*$"
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    }
  }
}
