{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wego.dev/foundry/product-manifest/v1",
  "title": "Wego product manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productId",
    "displayName",
    "version",
    "platformVersion",
    "requiredModules",
    "requiredCapabilities"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productId": {
      "type": "string",
      "pattern": "^wego-[a-z][a-z0-9-]*$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "$ref": "#/$defs/releaseVersion" },
    "platformVersion": { "$ref": "#/$defs/buildVersion" },
    "requiredModules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/moduleId" }
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityId" }
    }
  },
  "$defs": {
    "releaseVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "buildVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^(platform|product)\\.[a-z][a-z0-9-]*$"
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    }
  }
}
